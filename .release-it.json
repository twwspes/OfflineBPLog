{
  "git": {
    "requireBranch": "release/*",
    "requireCleanWorkingDir": true,
    "requireUpstream": false,
    "commitMessage": "chore: prepare release v${version}",
    "tag": false,
    "push": false,
    "tagName": "v${version}"
  },
  "npm": {
    "publish": false
  },
  "github": {
    "release": false
  },
  "plugins": {
    "@release-it/conventional-changelog": {
      "preset": "conventionalcommits"
    },
    "@release-it/bumper": {
      "out": {
        "file": "app.json",
        "path": ["expo.version", "expo.runtimeVersion"]
      }
    }
  },
  "hooks": {
    "before:init": [
      "node scripts/release-guard.mts prepare",
      "npm run build:bump -- --check",
      "npm run check",
      "npm test"
    ],
    "before:bump": "node scripts/release-guard.mts prepare ${version}",
    "after:bump": ["npm run build:bump", "npm run release:notes"]
  }
}
